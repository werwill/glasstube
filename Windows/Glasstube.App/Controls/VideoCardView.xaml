<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Glasstube.Controls.VideoCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    PointerCanceled="OnPointerExited"
    PointerCaptureLost="OnPointerExited">

    <!-- Tarjeta del Inicio: miniatura de 12 px de radio que se levanta al pasar el ratón, con un botón de reproducir
         encima, y debajo título en dos líneas, canal y vistas · fecha. -->
    <StackPanel Spacing="10" Padding="0,0,0,4">
        <Grid x:Name="Thumbnail" CornerRadius="12" Background="{ThemeResource ControlFillColorSecondaryBrush}">
            <Grid.TranslationTransition><Vector3Transition Duration="0:0:0.15" /></Grid.TranslationTransition>
            <Grid.Shadow><ThemeShadow /></Grid.Shadow>
            <Viewbox Stretch="UniformToFill">
                <Image x:Name="ThumbnailImage" Stretch="UniformToFill" Width="480" Height="270" />
            </Viewbox>
            <!-- Vista previa al dejar el ratón encima: los cuadros del storyboard, recortados de su hoja. -->
            <Canvas x:Name="PreviewCanvas" Visibility="Collapsed" SizeChanged="OnPreviewSizeChanged">
                <Image x:Name="PreviewImage" Stretch="Fill">
                    <Image.RenderTransform><CompositeTransform x:Name="PreviewTransform" /></Image.RenderTransform>
                </Image>
            </Canvas>
            <Border x:Name="PlayGlyph" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Background="#99000000" BorderBrush="#80FFFFFF" BorderThickness="1" Opacity="0">
                <Border.OpacityTransition><ScalarTransition Duration="0:0:0.15" /></Border.OpacityTransition>
                <FontIcon Glyph="&#xF5B0;" FontSize="18" Foreground="White" Margin="3,0,0,0" />
            </Border>
            <Border x:Name="DurationBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                    Padding="6,2" CornerRadius="5" Background="#CC000000">
                <TextBlock x:Name="DurationText" Foreground="White" FontSize="12" FontWeight="SemiBold" />
            </Border>
            <Border x:Name="LiveBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="6,2"
                    CornerRadius="4" Background="#E5CC0000" Visibility="Collapsed">
                <TextBlock Text="EN VIVO" Foreground="White" FontSize="11" FontWeight="Bold" CharacterSpacing="40" />
            </Border>
            <!-- Lo que ya se vio (biblioteca local). -->
            <Grid x:Name="ProgressTrack" VerticalAlignment="Bottom" Height="4" Background="#66FFFFFF" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ProgressDone" Width="0*" />
                    <ColumnDefinition x:Name="ProgressLeft" Width="1*" />
                </Grid.ColumnDefinitions>
                <Rectangle Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            </Grid>
        </Grid>
        <StackPanel Spacing="2" Padding="2,0">
            <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}"
                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            <!-- El canal abre su página (si se sabe su id); el resto de la tarjeta reproduce. -->
            <HyperlinkButton x:Name="ChannelLink" Padding="2,0" Margin="-2,0,0,0" MinHeight="0" IsTabStop="False"
                             HorizontalAlignment="Left" Click="OnChannelClick"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <TextBlock x:Name="ChannelText" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            </HyperlinkButton>
            <TextBlock x:Name="MetaText" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </StackPanel>
</UserControl>
