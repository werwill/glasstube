<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Glasstube.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Glasstube.Models"
    RequestedTheme="Dark"
    Background="Black"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.Resources>
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
        <Style x:Key="CapsuleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Píldoras de cristal de la fila de la cuenta (como la cápsula, más pequeñas). -->
        <Style x:Key="GlassPillStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="Background">
                <Setter.Value>
                    <AcrylicBrush TintColor="#000000" TintOpacity="0.55" TintLuminosityOpacity="0.35" FallbackColor="#E6202020" />
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Space" Invoked="OnTogglePauseKey" />
        <KeyboardAccelerator Key="K" Invoked="OnTogglePauseKey" />
        <KeyboardAccelerator Key="F" Invoked="OnFullScreenKey" />
        <KeyboardAccelerator Key="I" Invoked="OnMiniKey" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeKey" />
        <KeyboardAccelerator Key="Left" Invoked="OnSeekBackKey" />
        <KeyboardAccelerator Key="Right" Invoked="OnSeekForwardKey" />
        <KeyboardAccelerator Key="J" Invoked="OnSeekBack10Key" />
        <KeyboardAccelerator Key="L" Invoked="OnSeekForward10Key" />
        <KeyboardAccelerator Key="M" Invoked="OnMuteKey" />
        <KeyboardAccelerator Key="S" Invoked="OnSkipKey" />
        <KeyboardAccelerator Key="C" Invoked="OnCaptionsKey" />
        <KeyboardAccelerator Key="P" Invoked="OnPanelKey" />
        <!-- < y > (Shift+, y Shift+. en teclados de EE. UU.; la tecla < propia en los de España y Latinoamérica) se
             añaden en el código: VirtualKey no tiene nombre para esas teclas. -->
    </Page.KeyboardAccelerators>

    <!-- El video ocupa toda la ventana, también detrás de la barra de título (que aquí solo tiene atrás y los botones
         de la ventana). Título arriba a la izquierda con un degradado suave y controles en una cápsula flotante. -->
    <Grid x:Name="Root" Background="Black" PointerMoved="OnPointerActivity" PointerPressed="OnPointerActivity"
          PointerExited="OnPointerLeft" DoubleTapped="OnDoubleTapped">
        <SwapChainPanel x:Name="Panel" SizeChanged="OnPanelSizeChanged" CompositionScaleChanged="OnPanelScaleChanged" />

        <!-- Cargando / esperando datos -->
        <StackPanel x:Name="Spinner" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" IsHitTestVisible="False">
            <ProgressRing IsActive="True" Width="48" Height="48" Foreground="White" />
            <TextBlock x:Name="SpinnerText" Text="Buscando el video…" Foreground="#CCFFFFFF" HorizontalAlignment="Center" />
        </StackPanel>

        <InfoBar x:Name="ErrorBar" Severity="Error" Title="No se pudo reproducir" IsOpen="False" IsClosable="False"
                 VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720" Margin="24" />

        <!-- Controles (se ocultan solos mientras reproduce, junto con el cursor) -->
        <Grid x:Name="Controls">
            <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.25" /></Grid.OpacityTransition>

            <!-- Título y canal, junto al botón de atrás de la barra de título -->
            <Grid x:Name="TopOverlay" VerticalAlignment="Top" Height="140" IsHitTestVisible="False">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#99000000" Offset="0" />
                        <GradientStop Color="#40000000" Offset="0.45" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <StackPanel Margin="56,6,160,0" VerticalAlignment="Top">
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="16" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ChannelText" Foreground="#CCFFFFFF" Style="{StaticResource CaptionTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>


            <!-- Cuenta (PlayerPage.Account.cs): suscribirse y me gusta / no me gusta con los votos de Return YouTube
                 Dislike, bajo el título (la barra de título, encima, arrastra la ventana). -->
            <StackPanel x:Name="AccountRow" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Margin="56,60,0,0" Visibility="Collapsed">
                <Button x:Name="SubscribeButton" Style="{StaticResource GlassPillStyle}" Click="OnSubscribeClick"
                        AutomationProperties.Name="Suscribirse">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="SubscribeIcon" Glyph="&#xE710;" FontSize="12" />
                        <TextBlock x:Name="SubscribeText" Text="Suscribirse" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                </Button>
                <Border CornerRadius="17" BorderThickness="1" BorderBrush="#26FFFFFF" Height="34">
                    <Border.Background>
                        <AcrylicBrush TintColor="#000000" TintOpacity="0.55" TintLuminosityOpacity="0.35" FallbackColor="#E6202020" />
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LikeButton" Style="{StaticResource CapsuleButtonStyle}" Width="NaN" Height="32"
                                Padding="12,0,10,0" CornerRadius="16,0,0,16" Click="OnLikeClick" AutomationProperties.Name="Me gusta">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="LikeIcon" Glyph="&#xE8E1;" FontSize="14" />
                                <TextBlock x:Name="LikeText" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1" Height="18" Fill="#40FFFFFF" VerticalAlignment="Center" />
                        <Button x:Name="DislikeButton" Style="{StaticResource CapsuleButtonStyle}" Width="NaN" Height="32"
                                Padding="10,0,12,0" CornerRadius="0,16,16,0" Click="OnDislikeClick" AutomationProperties.Name="No me gusta">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="DislikeIcon" Glyph="&#xE8E0;" FontSize="14" />
                                <TextBlock x:Name="DislikeText" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Cápsula de controles -->
            <Border x:Name="Capsule" VerticalAlignment="Bottom" Margin="24,0,24,24" Padding="12,4,12,6" CornerRadius="16"
                    BorderThickness="1" BorderBrush="#26FFFFFF" MaxWidth="1400"
                    PointerEntered="OnCapsulePointerEntered" PointerExited="OnCapsulePointerExited"
                    SizeChanged="OnCapsuleSizeChanged">
                <Border.Background>
                    <AcrylicBrush TintColor="#000000" TintOpacity="0.55" TintLuminosityOpacity="0.35" FallbackColor="#E6202020" />
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- La barra de progreso: el Slider (sin pista propia) para el clic, el arrastre y el pulgar, y debajo la
                         pista dibujada en TrackLayer (PlayerPage.Chapters.cs): un tramo por capítulo con lo reproducido en
                         el color de acento y los segmentos de SponsorBlock sombreados. -->
                    <Grid x:Name="ProgressRow">
                        <Canvas x:Name="TrackLayer" IsHitTestVisible="False" Margin="4,0,4,-8" />
                        <Slider x:Name="Progress" AutomationProperties.Name="Progreso" Minimum="0" Maximum="1" StepFrequency="0.1"
                                IsThumbToolTipEnabled="False" ValueChanged="OnProgressChanged" Margin="4,0,4,-8"
                                SizeChanged="OnProgressSizeChanged">
                            <Slider.Resources>
                                <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                            </Slider.Resources>
                        </Slider>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PlayButton" AutomationProperties.Name="Reproducir o pausar" Click="OnPlayPause"
                                Style="{StaticResource CapsuleButtonStyle}" ToolTipService.ToolTip="Pausa (espacio o K)">
                            <FontIcon x:Name="PlayIcon" Glyph="&#xE769;" FontSize="16" />
                        </Button>
                        <Button Grid.Column="1" AutomationProperties.Name="Retroceder 10 segundos" Click="OnBack10"
                                Style="{StaticResource CapsuleButtonStyle}" ToolTipService.ToolTip="Retroceder 10 s (J)">
                            <FontIcon Glyph="&#xE7AD;" FontSize="15" RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform><ScaleTransform ScaleX="-1" /></FontIcon.RenderTransform>
                            </FontIcon>
                        </Button>
                        <Button Grid.Column="2" AutomationProperties.Name="Adelantar 10 segundos" Click="OnForward10"
                                Style="{StaticResource CapsuleButtonStyle}" ToolTipService.ToolTip="Adelantar 10 s (L)">
                            <FontIcon Glyph="&#xE7AD;" FontSize="15" />
                        </Button>
                        <TextBlock x:Name="TimeText" Grid.Column="3" Text="0:00 / 0:00" Foreground="White" FontSize="13"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />

                        <!-- Menús de velocidad, subtítulos, audio y calidad (PlayerPage.Menus.cs): se rellenan al abrirse. -->
                        <Button x:Name="SpeedButton" Grid.Column="5" AutomationProperties.Name="Velocidad"
                                Style="{StaticResource CapsuleButtonStyle}" Width="NaN" MinWidth="36" Padding="6,0"
                                ToolTipService.ToolTip="Velocidad (&lt; y &gt;)">
                            <Button.Flyout>
                                <MenuFlyout x:Name="SpeedMenu" Placement="Top" Opening="OnSpeedMenuOpening" Opened="OnMenuOpened" Closed="OnMenuClosed" />
                            </Button.Flyout>
                            <TextBlock x:Name="SpeedText" Text="1×" FontSize="13" FontWeight="SemiBold" />
                        </Button>
                        <Button x:Name="CaptionsButton" Grid.Column="6" AutomationProperties.Name="Subtítulos" IsEnabled="False"
                                Style="{StaticResource CapsuleButtonStyle}" ToolTipService.ToolTip="Subtítulos (C)">
                            <Button.Flyout>
                                <MenuFlyout x:Name="CaptionsMenu" Placement="Top" Opening="OnCaptionsMenuOpening" Opened="OnMenuOpened" Closed="OnMenuClosed" />
                            </Button.Flyout>
                            <Grid>
                                <FontIcon x:Name="CaptionsIcon" Glyph="&#xE7F0;" FontSize="16" />
                                <Border x:Name="CaptionsOnMark" Visibility="Collapsed" Height="2" CornerRadius="1" Margin="2,0,2,-8"
                                        VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Grid>
                        </Button>
                        <Button x:Name="AudioButton" Grid.Column="7" AutomationProperties.Name="Pista de audio" Visibility="Collapsed"
                                Style="{StaticResource CapsuleButtonStyle}" ToolTipService.ToolTip="Pista de audio">
                            <Button.Flyout>
                                <MenuFlyout x:Name="AudioMenu" Placement="Top" Opening="OnAudioMenuOpening" Opened="OnMenuOpened" Closed="OnMenuClosed" />
                            </Button.Flyout>
                            <FontIcon Glyph="&#xF2B7;" FontSize="16" />
                        </Button>
                        <Button x:Name="QualityButton" Grid.Column="8" AutomationProperties.Name="Calidad" IsEnabled="False"
                                Style="{StaticResource CapsuleButtonStyle}" Width="NaN" MinWidth="36" Padding="4,0"
                                ToolTipService.ToolTip="Calidad">
                            <Button.Flyout>
                                <MenuFlyout x:Name="QualityMenu" Placement="Top" Opening="OnQualityMenuOpening" Opened="OnMenuOpened" Closed="OnMenuClosed" />
                            </Button.Flyout>
                            <Grid>
                                <FontIcon x:Name="QualityIcon" Glyph="&#xE713;" FontSize="16" />
                                <Border x:Name="QualityBadge" Visibility="Collapsed" VerticalAlignment="Center"
                                        Padding="6,1" CornerRadius="4" BorderThickness="1" BorderBrush="#66FFFFFF">
                                    <TextBlock x:Name="QualityText" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Button>
                        <Button x:Name="MuteButton" Grid.Column="9" AutomationProperties.Name="Silenciar" Click="OnMute"
                                Style="{StaticResource CapsuleButtonStyle}" ToolTipService.ToolTip="Silenciar (M)">
                            <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="16" />
                        </Button>
                        <Slider x:Name="Volume" Grid.Column="10" AutomationProperties.Name="Volumen" Width="96" Minimum="0" Maximum="100"
                                Value="100" VerticalAlignment="Center" Margin="2,0,8,0" ValueChanged="OnVolumeChanged" />
                        <Button x:Name="PanelButton" Grid.Column="11" AutomationProperties.Name="Panel lateral" Click="OnTogglePanel"
                                Style="{StaticResource CapsuleButtonStyle}" ToolTipService.ToolTip="Descripción, comentarios y sugeridos (P)">
                            <FontIcon x:Name="PanelIcon" Glyph="&#xE8A0;" FontSize="16" />
                        </Button>
                        <Button Grid.Column="12" AutomationProperties.Name="Mini reproductor" Click="OnMini"
                                Style="{StaticResource CapsuleButtonStyle}" ToolTipService.ToolTip="Mini reproductor (I)">
                            <FontIcon Glyph="&#xEE49;" FontSize="16" />
                        </Button>
                        <Button Grid.Column="13" AutomationProperties.Name="Pantalla completa" Click="OnFullScreen"
                                Style="{StaticResource CapsuleButtonStyle}" ToolTipService.ToolTip="Pantalla completa (F)">
                            <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="16" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- SponsorBlock: «Saltar patrocinio» (o intro, créditos…) encima de la cápsula mientras se está en el tramo,
             aunque los controles estén ocultos. Botón o tecla S; salta al final del tramo. -->
        <Button x:Name="SkipButton" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,132" CornerRadius="18" Padding="16,8" Foreground="White" BorderThickness="1"
                BorderBrush="#33FFFFFF" Click="OnSkip" ToolTipService.ToolTip="Saltar (S)">
            <Button.Background>
                <AcrylicBrush TintColor="#000000" TintOpacity="0.5" TintLuminosityOpacity="0.3" FallbackColor="#E6202020" />
            </Button.Background>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE893;" FontSize="13" />
                <TextBlock x:Name="SkipText" Text="Saltar patrocinio" FontWeight="SemiBold" />
            </StackPanel>
        </Button>

        <!-- Aviso breve arriba al centro: velocidad, subtítulos, calidad… (ShowOsd). -->
        <Border x:Name="Osd" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,64,0,0" Padding="16,8"
                CornerRadius="12" BorderThickness="1" BorderBrush="#26FFFFFF" Opacity="0" IsHitTestVisible="False">
            <Border.OpacityTransition><ScalarTransition Duration="0:0:0.2" /></Border.OpacityTransition>
            <Border.Background>
                <AcrylicBrush TintColor="#000000" TintOpacity="0.55" TintLuminosityOpacity="0.35" FallbackColor="#E6202020" />
            </Border.Background>
            <TextBlock x:Name="OsdText" Foreground="White" FontSize="15" FontWeight="SemiBold" />
        </Border>

        <!-- Panel lateral (PlayerPage.Panel.cs): Descripción, Comentarios y Sugeridos. Flota a la derecha, de la barra
             de título a la base; la cápsula se estrecha para que no la tape. Botón o tecla P. -->
        <Border x:Name="SidePanel" Visibility="Collapsed" HorizontalAlignment="Right" Width="400" Margin="0,48,24,24"
                CornerRadius="16" BorderThickness="1" BorderBrush="#26FFFFFF"
                PointerEntered="OnSidePanelPointerEntered" PointerExited="OnSidePanelPointerExited">
            <Border.Background>
                <AcrylicBrush TintColor="#000000" TintOpacity="0.6" TintLuminosityOpacity="0.4" FallbackColor="#F0202020" />
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="8,6,6,0">
                    <SelectorBar x:Name="PanelTabs" SelectionChanged="OnPanelTabChanged">
                        <SelectorBarItem x:Name="DescriptionTab" Text="Descripción" IsSelected="True" />
                        <SelectorBarItem x:Name="CommentsTab" Text="Comentarios" />
                        <SelectorBarItem x:Name="SuggestionsTab" Text="Sugeridos" />
                    </SelectorBar>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CapsuleButtonStyle}"
                            Width="32" Height="32" Click="OnTogglePanel" AutomationProperties.Name="Cerrar el panel"
                            ToolTipService.ToolTip="Cerrar (P)">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>

                <!-- Descripción -->
                <ScrollViewer x:Name="DescriptionView" Grid.Row="1" Padding="16,8,16,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="PanelTitle" Foreground="White" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="PanelMeta" Foreground="#B3FFFFFF" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PersonPicture x:Name="PanelAvatar" Width="32" Height="32" />
                            <TextBlock x:Name="PanelChannel" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock x:Name="PanelDescription" Foreground="#E6FFFFFF" FontSize="13" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" Text="Cargando…" />
                        <TextBlock x:Name="ChaptersHeader" Text="Capítulos" Foreground="White" FontWeight="SemiBold"
                                   Margin="0,8,0,0" Visibility="Collapsed" />
                        <StackPanel x:Name="ChaptersList" Spacing="2" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Comentarios -->
                <Grid x:Name="CommentsView" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,8,16,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CommentsCountText" Foreground="#B3FFFFFF" FontSize="12" VerticalAlignment="Center" />
                        <StackPanel x:Name="CommentSortButtons" Grid.Column="1" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                            <ToggleButton x:Name="TopCommentsButton" Content="Destacados" IsChecked="True" Click="OnCommentSort"
                                          Padding="10,3" FontSize="12" />
                            <ToggleButton x:Name="NewestCommentsButton" Content="Recientes" Click="OnCommentSort"
                                          Padding="10,3" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="CommentsScroller" Grid.Row="1" Padding="16,4,16,16" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14">
                            <StackPanel x:Name="CommentsList" Spacing="14" />
                            <ProgressRing x:Name="CommentsSpinner" IsActive="False" Width="24" Height="24" Foreground="White" />
                            <TextBlock x:Name="CommentsMessage" Foreground="#B3FFFFFF" TextWrapping="Wrap" Visibility="Collapsed" />
                            <Button x:Name="MoreCommentsButton" Content="Cargar más" HorizontalAlignment="Center"
                                    Visibility="Collapsed" Click="OnMoreComments" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Sugeridos -->
                <Grid x:Name="SuggestionsView" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ToggleSwitch x:Name="AutoplaySwitch" Margin="16,4,16,0" Header="Reproducción automática"
                                  OnContent="Sigue con el siguiente al terminar" OffContent="Desactivada" Toggled="OnAutoplayToggled" />
                    <ListView x:Name="SuggestionsList" Grid.Row="1" Padding="8,4,8,12" SelectionMode="None"
                              IsItemClickEnabled="True" ItemClick="OnSuggestionClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:VideoCard">
                                <Grid ColumnSpacing="10" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="152" Height="86" CornerRadius="8" Background="#33FFFFFF" VerticalAlignment="Top">
                                        <Image Source="{x:Bind ThumbnailImage}" Stretch="UniformToFill" />
                                        <Border Visibility="{x:Bind HasDuration}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="4" Padding="4,0" CornerRadius="4" Background="#CC000000">
                                            <TextBlock Text="{x:Bind Duration}" Foreground="White" FontSize="11" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Channel}" Foreground="#B3FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Meta}" Foreground="#99FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="SuggestionsMessage" Grid.Row="1" Margin="16" Foreground="#B3FFFFFF" TextWrapping="Wrap"
                               Text="Cargando…" />
                </Grid>
            </Grid>
        </Border>

        <!-- Reproducción automática: al terminar, el siguiente sugerido con una cuenta atrás de 5 s cancelable. -->
        <Border x:Name="UpNextCard" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Width="360" Margin="0,0,24,132" Padding="12" CornerRadius="14" BorderThickness="1" BorderBrush="#33FFFFFF">
            <Border.Background>
                <AcrylicBrush TintColor="#000000" TintOpacity="0.6" TintLuminosityOpacity="0.4" FallbackColor="#F0202020" />
            </Border.Background>
            <StackPanel Spacing="10">
                <TextBlock x:Name="UpNextCountdown" Text="Siguiente en 5" Foreground="#CCFFFFFF" FontSize="12" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="128" Height="72" CornerRadius="8" Background="#33FFFFFF">
                        <Image x:Name="UpNextImage" Stretch="UniformToFill" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="UpNextTitle" Foreground="White" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                   MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="UpNextChannel" Foreground="#B3FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Click="OnCancelUpNext" />
                    <Button Content="Reproducir ya" Style="{StaticResource AccentButtonStyle}" Click="OnPlayUpNext" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Mini reproductor: solo al pasar el ratón; reproducir/pausa, tiempo y volver a la ventana. -->
        <Grid x:Name="MiniControls" Visibility="Collapsed" Opacity="0">
            <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.2" /></Grid.OpacityTransition>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33000000" Offset="0" />
                    <GradientStop Color="#99000000" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Button x:Name="MiniPlayButton" HorizontalAlignment="Center" VerticalAlignment="Center" Width="52" Height="52"
                    CornerRadius="26" Background="#66000000" BorderThickness="0" Foreground="White" Click="OnPlayPause"
                    AutomationProperties.Name="Reproducir o pausar">
                <FontIcon x:Name="MiniPlayIcon" Glyph="&#xE769;" FontSize="20" />
            </Button>
            <TextBlock x:Name="MiniTimeText" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,12"
                       Foreground="White" FontSize="12" />
            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,6" Style="{StaticResource CapsuleButtonStyle}"
                    Click="OnMini" AutomationProperties.Name="Volver a la ventana" ToolTipService.ToolTip="Volver a la ventana (I)">
                <FontIcon Glyph="&#xEE47;" FontSize="16" />
            </Button>
        </Grid>
    </Grid>
</Page>
