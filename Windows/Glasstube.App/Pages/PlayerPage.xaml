<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Glasstube.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="Black"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.Resources>
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
        <Style x:Key="CapsuleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Space" Invoked="OnTogglePauseKey" />
        <KeyboardAccelerator Key="K" Invoked="OnTogglePauseKey" />
        <KeyboardAccelerator Key="F" Invoked="OnFullScreenKey" />
        <KeyboardAccelerator Key="I" Invoked="OnMiniKey" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeKey" />
        <KeyboardAccelerator Key="Left" Invoked="OnSeekBackKey" />
        <KeyboardAccelerator Key="Right" Invoked="OnSeekForwardKey" />
        <KeyboardAccelerator Key="J" Invoked="OnSeekBack10Key" />
        <KeyboardAccelerator Key="L" Invoked="OnSeekForward10Key" />
        <KeyboardAccelerator Key="M" Invoked="OnMuteKey" />
        <KeyboardAccelerator Key="S" Invoked="OnSkipKey" />
    </Page.KeyboardAccelerators>

    <!-- El video ocupa toda la ventana, también detrás de la barra de título (que aquí solo tiene atrás y los botones
         de la ventana). Título arriba a la izquierda con un degradado suave y controles en una cápsula flotante. -->
    <Grid x:Name="Root" Background="Black" PointerMoved="OnPointerActivity" PointerPressed="OnPointerActivity"
          PointerExited="OnPointerLeft" DoubleTapped="OnDoubleTapped">
        <SwapChainPanel x:Name="Panel" SizeChanged="OnPanelSizeChanged" CompositionScaleChanged="OnPanelScaleChanged" />

        <!-- Cargando / esperando datos -->
        <StackPanel x:Name="Spinner" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" IsHitTestVisible="False">
            <ProgressRing IsActive="True" Width="48" Height="48" Foreground="White" />
            <TextBlock x:Name="SpinnerText" Text="Buscando el video…" Foreground="#CCFFFFFF" HorizontalAlignment="Center" />
        </StackPanel>

        <InfoBar x:Name="ErrorBar" Severity="Error" Title="No se pudo reproducir" IsOpen="False" IsClosable="False"
                 VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720" Margin="24" />

        <!-- Controles (se ocultan solos mientras reproduce, junto con el cursor) -->
        <Grid x:Name="Controls">
            <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.25" /></Grid.OpacityTransition>

            <!-- Título y canal, junto al botón de atrás de la barra de título -->
            <Grid x:Name="TopOverlay" VerticalAlignment="Top" Height="140" IsHitTestVisible="False">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#99000000" Offset="0" />
                        <GradientStop Color="#40000000" Offset="0.45" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <StackPanel Margin="56,6,160,0" VerticalAlignment="Top">
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="16" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ChannelText" Foreground="#CCFFFFFF" Style="{StaticResource CaptionTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>


            <!-- Cápsula de controles -->
            <Border x:Name="Capsule" VerticalAlignment="Bottom" Margin="24,0,24,24" Padding="12,4,12,6" CornerRadius="16"
                    BorderThickness="1" BorderBrush="#26FFFFFF" MaxWidth="1400"
                    PointerEntered="OnCapsulePointerEntered" PointerExited="OnCapsulePointerExited"
                    SizeChanged="OnCapsuleSizeChanged">
                <Border.Background>
                    <AcrylicBrush TintColor="#000000" TintOpacity="0.55" TintLuminosityOpacity="0.35" FallbackColor="#E6202020" />
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- La barra de progreso: el Slider (sin pista propia) para el clic, el arrastre y el pulgar, y debajo la
                         pista dibujada en TrackLayer (PlayerPage.Chapters.cs): un tramo por capítulo con lo reproducido en
                         el color de acento y los segmentos de SponsorBlock sombreados. -->
                    <Grid x:Name="ProgressRow">
                        <Canvas x:Name="TrackLayer" IsHitTestVisible="False" Margin="4,0,4,-8" />
                        <Slider x:Name="Progress" AutomationProperties.Name="Progreso" Minimum="0" Maximum="1" StepFrequency="0.1"
                                IsThumbToolTipEnabled="False" ValueChanged="OnProgressChanged" Margin="4,0,4,-8"
                                SizeChanged="OnProgressSizeChanged">
                            <Slider.Resources>
                                <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                            </Slider.Resources>
                        </Slider>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PlayButton" AutomationProperties.Name="Reproducir o pausar" Click="OnPlayPause"
                                Style="{StaticResource CapsuleButtonStyle}" ToolTipService.ToolTip="Pausa (espacio o K)">
                            <FontIcon x:Name="PlayIcon" Glyph="&#xE769;" FontSize="16" />
                        </Button>
                        <Button Grid.Column="1" AutomationProperties.Name="Retroceder 10 segundos" Click="OnBack10"
                                Style="{StaticResource CapsuleButtonStyle}" ToolTipService.ToolTip="Retroceder 10 s (J)">
                            <FontIcon Glyph="&#xE7AD;" FontSize="15" RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform><ScaleTransform ScaleX="-1" /></FontIcon.RenderTransform>
                            </FontIcon>
                        </Button>
                        <Button Grid.Column="2" AutomationProperties.Name="Adelantar 10 segundos" Click="OnForward10"
                                Style="{StaticResource CapsuleButtonStyle}" ToolTipService.ToolTip="Adelantar 10 s (L)">
                            <FontIcon Glyph="&#xE7AD;" FontSize="15" />
                        </Button>
                        <TextBlock x:Name="TimeText" Grid.Column="3" Text="0:00 / 0:00" Foreground="White" FontSize="13"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />

                        <!-- Subtítulos: llegan en otro paso. -->
                        <Button Grid.Column="5" IsEnabled="False" AutomationProperties.Name="Subtítulos"
                                Style="{StaticResource CapsuleButtonStyle}" ToolTipService.ToolTip="Subtítulos (próximamente)">
                            <FontIcon Glyph="&#xE7F0;" FontSize="16" />
                        </Button>
                        <Border x:Name="QualityBadge" Grid.Column="6" Visibility="Collapsed" VerticalAlignment="Center"
                                Margin="4,0" Padding="6,1" CornerRadius="4" BorderThickness="1" BorderBrush="#66FFFFFF">
                            <TextBlock x:Name="QualityText" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <Button x:Name="MuteButton" Grid.Column="7" AutomationProperties.Name="Silenciar" Click="OnMute"
                                Style="{StaticResource CapsuleButtonStyle}" ToolTipService.ToolTip="Silenciar (M)">
                            <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="16" />
                        </Button>
                        <Slider x:Name="Volume" Grid.Column="8" AutomationProperties.Name="Volumen" Width="96" Minimum="0" Maximum="100"
                                Value="100" VerticalAlignment="Center" Margin="2,0,8,0" ValueChanged="OnVolumeChanged" />
                        <Button Grid.Column="9" AutomationProperties.Name="Mini reproductor" Click="OnMini"
                                Style="{StaticResource CapsuleButtonStyle}" ToolTipService.ToolTip="Mini reproductor (I)">
                            <FontIcon Glyph="&#xEE49;" FontSize="16" />
                        </Button>
                        <Button Grid.Column="10" AutomationProperties.Name="Pantalla completa" Click="OnFullScreen"
                                Style="{StaticResource CapsuleButtonStyle}" ToolTipService.ToolTip="Pantalla completa (F)">
                            <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="16" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- SponsorBlock: «Saltar patrocinio» (o intro, créditos…) encima de la cápsula mientras se está en el tramo,
             aunque los controles estén ocultos. Botón o tecla S; salta al final del tramo. -->
        <Button x:Name="SkipButton" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,132" CornerRadius="18" Padding="16,8" Foreground="White" BorderThickness="1"
                BorderBrush="#33FFFFFF" Click="OnSkip" ToolTipService.ToolTip="Saltar (S)">
            <Button.Background>
                <AcrylicBrush TintColor="#000000" TintOpacity="0.5" TintLuminosityOpacity="0.3" FallbackColor="#E6202020" />
            </Button.Background>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE893;" FontSize="13" />
                <TextBlock x:Name="SkipText" Text="Saltar patrocinio" FontWeight="SemiBold" />
            </StackPanel>
        </Button>

        <!-- Mini reproductor: solo al pasar el ratón; reproducir/pausa, tiempo y volver a la ventana. -->
        <Grid x:Name="MiniControls" Visibility="Collapsed" Opacity="0">
            <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.2" /></Grid.OpacityTransition>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33000000" Offset="0" />
                    <GradientStop Color="#99000000" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Button x:Name="MiniPlayButton" HorizontalAlignment="Center" VerticalAlignment="Center" Width="52" Height="52"
                    CornerRadius="26" Background="#66000000" BorderThickness="0" Foreground="White" Click="OnPlayPause"
                    AutomationProperties.Name="Reproducir o pausar">
                <FontIcon x:Name="MiniPlayIcon" Glyph="&#xE769;" FontSize="20" />
            </Button>
            <TextBlock x:Name="MiniTimeText" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,12"
                       Foreground="White" FontSize="12" />
            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,6" Style="{StaticResource CapsuleButtonStyle}"
                    Click="OnMini" AutomationProperties.Name="Volver a la ventana" ToolTipService.ToolTip="Volver a la ventana (I)">
                <FontIcon Glyph="&#xEE47;" FontSize="16" />
            </Button>
        </Grid>
    </Grid>
</Page>
