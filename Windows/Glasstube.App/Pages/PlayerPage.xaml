<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Glasstube.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="Black">

    <Page.Resources>
        <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinWidth" Value="40" />
        </Style>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Space" Invoked="OnTogglePauseKey" />
        <KeyboardAccelerator Key="K" Invoked="OnTogglePauseKey" />
        <KeyboardAccelerator Key="F" Invoked="OnFullScreenKey" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeKey" />
        <KeyboardAccelerator Key="Left" Invoked="OnSeekBackKey" />
        <KeyboardAccelerator Key="Right" Invoked="OnSeekForwardKey" />
        <KeyboardAccelerator Key="M" Invoked="OnMuteKey" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="Root" Background="Black" PointerMoved="OnPointerActivity" PointerPressed="OnPointerActivity"
          DoubleTapped="OnDoubleTapped">
        <SwapChainPanel x:Name="Panel" SizeChanged="OnPanelSizeChanged" CompositionScaleChanged="OnPanelScaleChanged" />

        <!-- Cargando / esperando datos -->
        <StackPanel x:Name="Spinner" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" IsHitTestVisible="False">
            <ProgressRing IsActive="True" Width="48" Height="48" Foreground="White" />
            <TextBlock x:Name="SpinnerText" Text="Buscando el video…" Foreground="#CCFFFFFF" HorizontalAlignment="Center" />
        </StackPanel>

        <InfoBar x:Name="ErrorBar" Severity="Error" Title="No se pudo reproducir" IsOpen="False" IsClosable="False"
                 VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720" Margin="24" />

        <!-- Controles (se ocultan solos mientras reproduce) -->
        <Grid x:Name="Controls">
            <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.25" /></Grid.OpacityTransition>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="16,12,24,40">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B0000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="OnBack" AutomationProperties.Name="Volver" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Volver">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" Foreground="White" />
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Foreground="White" Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="1100" />
                        <TextBlock x:Name="ChannelText" Foreground="#CCFFFFFF" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Padding="20,48,20,14">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#C8000000" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Slider x:Name="Progress" AutomationProperties.Name="Progreso" Minimum="0" Maximum="1" StepFrequency="0.1" IsThumbToolTipEnabled="False"
                        ValueChanged="OnProgressChanged" Margin="0,0,0,-4" />

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayButton" AutomationProperties.Name="Reproducir o pausar" Click="OnPlayPause" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Pausa (espacio)">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE769;" FontSize="18" Foreground="White" />
                    </Button>
                    <TextBlock x:Name="TimeText" Grid.Column="1" Text="0:00 / 0:00" Foreground="White" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <Button x:Name="MuteButton" AutomationProperties.Name="Silenciar" Grid.Column="3" Click="OnMute" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Silenciar (M)">
                        <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="16" Foreground="White" />
                    </Button>
                    <Slider x:Name="Volume" AutomationProperties.Name="Volumen" Grid.Column="4" Width="110" Minimum="0" Maximum="100" Value="100"
                            VerticalAlignment="Center" ValueChanged="OnVolumeChanged" />
                    <Button Grid.Column="5" Click="OnFullScreen" AutomationProperties.Name="Pantalla completa" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Pantalla completa (F)">
                        <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="16" Foreground="White" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
