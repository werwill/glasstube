<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Glasstube.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Glasstube.Controls">

    <!-- Biblioteca: Ver más tarde de esta PC, y con sesión el Ver más tarde y las listas de la cuenta. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,20,32,32" Spacing="28">
            <StackPanel Spacing="4">
                <TextBlock Text="Biblioteca" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="MetaText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" />

            <StackPanel x:Name="LocalSection" Spacing="8">
                <controls:VideoRow x:Name="LocalWatchLater" Title="Ver más tarde · en esta PC"
                                   VideoInvoked="OnVideoInvoked" ItemContextRequested="OnLocalContext" />
                <StackPanel x:Name="LocalEmpty" Visibility="Collapsed" Spacing="4">
                    <TextBlock Text="Ver más tarde · en esta PC" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Aún no hay nada. Usa «Ver más tarde» en la portada del Inicio para guardar videos aquí." />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="AccountWatchLaterSection" Spacing="8" Visibility="Collapsed">
                <controls:VideoRow x:Name="AccountWatchLater" Title="Ver más tarde · YouTube" VideoInvoked="OnVideoInvoked" />
                <HyperlinkButton x:Name="AllWatchLater" Content="Ver toda la lista" Click="OnAllWatchLater" Visibility="Collapsed" />
            </StackPanel>

            <controls:VideoRow x:Name="Playlists" Title="Listas" Visibility="Collapsed" VideoInvoked="OnVideoInvoked" />

            <ProgressRing x:Name="Loading" IsActive="False" Width="32" Height="32" HorizontalAlignment="Left"
                          Visibility="{x:Bind Loading.IsActive, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
