<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Glasstube.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="24">
        <FontIcon Glyph="&#xE721;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" />
        <TextBlock Text="Próximamente: resultados de videos, canales y listas." HorizontalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</Page>
