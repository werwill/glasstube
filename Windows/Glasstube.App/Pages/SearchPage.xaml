<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Glasstube.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Glasstube.Models"
    xmlns:controls="using:Glasstube.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Margin="32,20,32,8" Style="{StaticResource TitleTextBlockStyle}"
                   TextTrimming="CharacterEllipsis" />

        <InfoBar x:Name="Notice" Grid.Row="1" VerticalAlignment="Top" Margin="32,0,32,0" IsOpen="False" IsClosable="True" />

        <controls:VideoGrid x:Name="Results" Grid.Row="1" ItemClick="OnItemClick">
            <!-- Canales de los resultados: abren su página. -->
            <controls:VideoGrid.Header>
                <ScrollViewer x:Name="ChannelsScroller" Visibility="Collapsed" Margin="28,4,28,12" HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ChannelsRow" Orientation="Horizontal" Spacing="12" Padding="0,0,0,8" />
                </ScrollViewer>
            </controls:VideoGrid.Header>
        </controls:VideoGrid>

        <StackPanel x:Name="LoadingPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock Text="Buscando…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
