<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Glasstube.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Configuración al estilo de la de Windows 11: secciones con tarjetas de una fila (texto a la izquierda, control a
         la derecha). Todo se guarda al cambiar (AppSettings y PlayerSettings). -->
    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinHeight" Value="64" />
        </Style>
        <Style x:Key="SectionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="2,20,0,6" />
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="32,20,32,32" MaxWidth="860" HorizontalAlignment="Left" Spacing="4">
            <TextBlock Text="Configuración" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

            <!-- Cuenta -->
            <TextBlock Text="Cuenta" Style="{StaticResource SectionStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PersonPicture x:Name="AccountPicture" Width="40" Height="40" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AccountName" Text="Sin sesión" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AccountByline" Style="{StaticResource HintStyle}"
                                   Text="Con tu cuenta ves tu Inicio, tus suscripciones y los videos con restricción de edad." />
                    </StackPanel>
                    <Button x:Name="AccountButton" Grid.Column="2" VerticalAlignment="Center" Click="OnAccountClick" />
                </Grid>
            </Border>

            <!-- Apariencia -->
            <TextBlock Text="Apariencia" Style="{StaticResource SectionStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Tema" />
                        <TextBlock Text="El de Windows, o siempre claro u oscuro." Style="{StaticResource HintStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeBox" Grid.Column="2" VerticalAlignment="Center" MinWidth="160"
                              SelectionChanged="OnThemeChanged" AutomationProperties.Name="Tema">
                        <ComboBoxItem Content="El de Windows" Tag="sistema" />
                        <ComboBoxItem Content="Claro" Tag="claro" />
                        <ComboBoxItem Content="Oscuro" Tag="oscuro" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B3;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Vista previa al pasar el ratón" />
                        <TextBlock Text="Si dejas el ratón sobre una miniatura, pasa por los momentos del video." Style="{StaticResource HintStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="HoverSwitch" Grid.Column="2" OnContent="" OffContent="" MinWidth="0"
                                  Toggled="OnHoverToggled" AutomationProperties.Name="Vista previa al pasar el ratón" />
                </Grid>
            </Border>

            <!-- Reproductor -->
            <TextBlock Text="Reproductor" Style="{StaticResource SectionStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B2;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Calidad" />
                        <TextBlock Text="La máxima con la que empiezan los videos. También se cambia en el reproductor." Style="{StaticResource HintStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="QualityBox" Grid.Column="2" VerticalAlignment="Center" MinWidth="160"
                              SelectionChanged="OnQualityChanged" AutomationProperties.Name="Calidad">
                        <ComboBoxItem Content="Auto (hasta 1080p)" Tag="0" />
                        <ComboBoxItem Content="2160p (4K)" Tag="2160" />
                        <ComboBoxItem Content="1440p" Tag="1440" />
                        <ComboBoxItem Content="1080p" Tag="1080" />
                        <ComboBoxItem Content="720p" Tag="720" />
                        <ComboBoxItem Content="480p" Tag="480" />
                        <ComboBoxItem Content="360p" Tag="360" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xED1E;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Subtítulos" />
                        <TextBlock Text="Activarlos al empezar un video, en el último idioma que elegiste." Style="{StaticResource HintStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="CaptionsSwitch" Grid.Column="2" OnContent="" OffContent="" MinWidth="0"
                                  Toggled="OnCaptionsToggled" AutomationProperties.Name="Subtítulos al empezar" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE893;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Reproducción automática" />
                        <TextBlock Text="Al terminar, sigue con el próximo sugerido tras una cuenta atrás." Style="{StaticResource HintStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoplaySwitch" Grid.Column="2" OnContent="" OffContent="" MinWidth="0"
                                  Toggled="OnAutoplayToggled" AutomationProperties.Name="Reproducción automática" />
                </Grid>
            </Border>

            <!-- DeArrow -->
            <TextBlock Text="DeArrow" Style="{StaticResource SectionStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8D2;" FontSize="18" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Títulos y miniaturas de la comunidad" />
                            <TextBlock Style="{StaticResource HintStyle}"
                                       Text="Cambia los títulos exagerados y las miniaturas engañosas por los que vota la comunidad de DeArrow (dearrow.ajay.app). Se consulta por un prefijo del id, sin mandar qué ves." />
                        </StackPanel>
                        <ToggleSwitch x:Name="DeArrowSwitch" Grid.Column="2" OnContent="" OffContent="" MinWidth="0"
                                      Toggled="OnDeArrowToggled" AutomationProperties.Name="DeArrow" />
                    </Grid>
                    <StackPanel x:Name="DeArrowOptions" Margin="34,0,0,0" Spacing="4">
                        <CheckBox x:Name="DeArrowTitlesBox" Content="Títulos" Click="OnDeArrowOptionClick" />
                        <CheckBox x:Name="DeArrowThumbnailsBox" Content="Miniaturas" Click="OnDeArrowOptionClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Actualizaciones -->
            <TextBlock Text="Actualizaciones" Style="{StaticResource SectionStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE895;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" />
                        <TextBlock x:Name="UpdateText" Style="{StaticResource HintStyle}"
                                   Text="Al abrirse, como mucho una vez al día, busca una versión nueva en GitHub." />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="CheckNowButton" Content="Buscar ahora" Click="OnCheckNowClick" />
                        <ToggleSwitch x:Name="UpdatesSwitch" OnContent="" OffContent="" MinWidth="0"
                                      Toggled="OnUpdatesToggled" AutomationProperties.Name="Buscar versiones nuevas" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Datos -->
            <TextBlock Text="Datos de esta PC" Style="{StaticResource SectionStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE81C;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Historial" />
                        <TextBlock Text="Lo que viste en esta PC (Continuar viendo y la página Historial)." Style="{StaticResource HintStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Center" Content="Borrar el historial" Click="OnClearHistoryClick" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9F9;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Registro" />
                        <TextBlock x:Name="LogText" Style="{StaticResource HintStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Center" Content="Abrir la carpeta" Click="OnOpenLogsClick" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
