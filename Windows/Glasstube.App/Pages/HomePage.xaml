<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Glasstube.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Glasstube.Models"
    xmlns:controls="using:Glasstube.Controls"
    NavigationCacheMode="Enabled">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="32,20,32,8">
            <TextBlock Text="Inicio" Style="{StaticResource TitleTextBlockStyle}" />
            <Button x:Name="RefreshButton" HorizontalAlignment="Right" Click="OnRefresh" ToolTipService.ToolTip="Actualizar">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <InfoBar x:Name="Notice" Grid.Row="1" VerticalAlignment="Top" Margin="32,0,32,0" IsOpen="False" IsClosable="True" />

        <GridView
            x:Name="Grid"
            Grid.Row="1"
            Padding="28,4,28,24"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            SizeChanged="OnGridSizeChanged"
            IncrementalLoadingThreshold="2"
            IncrementalLoadingTrigger="Edge">
            <!-- La tarjeta hace su propio efecto al pasar el ratón: sin el fondo gris del elemento. -->
            <GridView.Resources>
                <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                <SolidColorBrush x:Key="GridViewItemPointerOverBorderBrush" Color="Transparent" />
                <StaticResource x:Key="GridViewItemForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
            </GridView.Resources>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Margin" Value="4,4,4,12" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Top" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="320" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:VideoCard">
                    <controls:VideoCardView Video="{x:Bind}" />
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel x:Name="LoadingPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock x:Name="LoadingText" Text="Cargando el Inicio…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
