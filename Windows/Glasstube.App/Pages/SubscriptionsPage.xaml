<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Glasstube.Pages.SubscriptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Glasstube.Pages"
    NavigationCacheMode="Enabled"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.Resources>
        <CollectionViewSource x:Name="Groups" IsSourceGrouped="True" />
        <!-- Fila elegida: tinte del acento (además de la píldora de la lista). -->
        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.16" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.22" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="J" Invoked="OnNextKey" />
        <KeyboardAccelerator Key="K" Invoked="OnPreviousKey" />
        <KeyboardAccelerator Key="Enter" Invoked="OnPlayKey" />
        <KeyboardAccelerator Key="W" Invoked="OnWatchLaterKey" />
        <KeyboardAccelerator Key="E" Invoked="OnArchiveKey" />
        <KeyboardAccelerator Modifiers="Shift" Key="U" Invoked="OnToggleSeenKey" />
    </Page.KeyboardAccelerators>

    <!-- Bandeja: lista de videos por día a la izquierda y vista previa flotante a la derecha. -->
    <Grid Padding="4,0,12,12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="16,14,4,0">
                <TextBlock x:Name="HeaderText" Text="Suscripciones" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis"
                           Margin="0,0,120,0" />
                <HyperlinkButton x:Name="FilterButton" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnClearFilter"
                                 FontSize="12" Padding="6,2">
                    <TextBlock x:Name="FilterText" Text="Todos los canales" />
                </HyperlinkButton>
            </Grid>

            <SelectorBar x:Name="Tabs" Grid.Row="1" Margin="8,4,0,4" SelectionChanged="OnTabChanged">
                <SelectorBarItem x:Name="InboxTab" Text="Sin ver" IsSelected="True" />
                <SelectorBarItem x:Name="LaterTab" Text="Más tarde" />
                <SelectorBarItem x:Name="ArchivedTab" Text="Archivados" />
            </SelectorBar>

            <ListView x:Name="List" Grid.Row="2" ItemsSource="{x:Bind Groups.View, Mode=OneWay}" SelectionMode="Single"
                      SelectionChanged="OnSelectionChanged" DoubleTapped="OnListDoubleTapped" Padding="0,0,0,12">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="local:InboxGroup">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" CharacterSpacing="40" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="8,6,8,6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:InboxRow">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"
                                     Visibility="{x:Bind UnseenVisibility, Mode=OneWay}" />
                            <Grid Grid.Column="1" Width="112" Height="63" CornerRadius="6"
                                  Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <Image Source="{x:Bind Card.ThumbnailImage}" Stretch="UniformToFill" />
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" Padding="4,1" CornerRadius="4"
                                        Background="{x:Bind BadgeBrush}" Visibility="{x:Bind BadgeVisibility}">
                                    <TextBlock Text="{x:Bind Badge}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" Opacity="{x:Bind TitleOpacity, Mode=OneWay}">
                                <TextBlock Text="{x:Bind Card.Title}" FontWeight="{x:Bind TitleWeight, Mode=OneWay}" TextWrapping="Wrap"
                                           MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="13" />
                                <TextBlock Text="{x:Bind Meta}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <HyperlinkButton x:Name="MoreButton" Content="Cargar más" HorizontalAlignment="Center" Margin="0,8" Click="OnLoadMore"
                                     Visibility="Collapsed" />
                </ListView.Footer>
            </ListView>

            <StackPanel x:Name="EmptyPanel" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="Collapsed" Padding="24">
                <FontIcon Glyph="&#xE73E;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="EmptyText" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="SignInButton" Style="{StaticResource AccentButtonStyle}" Content="Iniciar sesión" HorizontalAlignment="Center"
                        Margin="0,8,0,0" Visibility="Collapsed" Click="OnSignInClick" />
            </StackPanel>
            <ProgressRing x:Name="Loading" Grid.Row="2" IsActive="True" Width="36" Height="36" />
        </Grid>

        <!-- Vista previa flotante -->
        <Border Grid.Column="1" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <Grid>
                <ScrollViewer x:Name="Preview" Visibility="Collapsed" Padding="24,20">
                    <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
                        <Grid x:Name="PreviewThumbnail" CornerRadius="10" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                              Tapped="OnPreviewThumbnailTapped">
                            <Viewbox Stretch="UniformToFill">
                                <Image x:Name="PreviewImage" Width="1280" Height="720" Stretch="UniformToFill" />
                            </Viewbox>
                            <Border Width="56" Height="56" CornerRadius="28" Background="#99000000" BorderBrush="#80FFFFFF"
                                    BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xF5B0;" FontSize="20" Foreground="White" Margin="3,0,0,0" />
                            </Border>
                            <Border x:Name="PreviewBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Padding="6,2"
                                    CornerRadius="5" Background="#CC000000">
                                <TextBlock x:Name="PreviewBadgeText" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="PreviewTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PersonPicture x:Name="PreviewAvatar" Width="24" Height="24" />
                            <TextBlock x:Name="PreviewMeta" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource AccentButtonStyle}" Click="OnPlay" ToolTipService.ToolTip="Ver (Intro)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xF5B0;" FontSize="12" />
                                    <TextBlock Text="Ver" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnWatchLater" ToolTipService.ToolTip="Ver más tarde (W)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon x:Name="LaterIcon" Glyph="&#xE823;" FontSize="13" />
                                    <TextBlock x:Name="LaterText" Text="Más tarde" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnToggleSeen" ToolTipService.ToolTip="Marcar como visto o no visto (Mayús+U)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE73E;" FontSize="13" />
                                    <TextBlock x:Name="SeenText" Text="Visto" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnArchive" ToolTipService.ToolTip="Archivar (E)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7B8;" FontSize="13" />
                                    <TextBlock x:Name="ArchiveText" Text="Archivar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="PreviewDescription" TextWrapping="Wrap" MaxLines="8" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BodyTextBlockStyle}" />
                        <StackPanel x:Name="ChaptersPanel" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="Capítulos" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsControl x:Name="ChaptersList" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="J / K moverte · Intro ver · W más tarde · E archivar · Mayús+U visto" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock x:Name="PreviewEmpty" Text="Elige un video para ver los detalles." HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Page>
