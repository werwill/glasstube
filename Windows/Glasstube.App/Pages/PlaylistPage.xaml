<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Glasstube.Pages.PlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Glasstube.Controls">

    <!-- Los videos de una lista (gt_playlist), con carga incremental. -->
    <Grid>
        <controls:VideoGrid x:Name="Results" ItemClick="OnItemClick">
            <controls:VideoGrid.Header>
                <StackPanel Margin="32,20,32,8" Spacing="8">
                    <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MetaText" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="False" />
                    <ProgressRing x:Name="Loading" IsActive="False" Visibility="{x:Bind Loading.IsActive, Mode=OneWay}" Width="32" Height="32" HorizontalAlignment="Left" />
                </StackPanel>
            </controls:VideoGrid.Header>
        </controls:VideoGrid>
    </Grid>
</Page>
